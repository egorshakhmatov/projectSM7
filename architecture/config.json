{
  "specification_version": 2,
  "basis": "Согласованная постановка: задержки, шаг 15 минут, горизонт 60 минут",
  "device": "cpu",
  "input": {
    "window_size": 8,
    "feature_names": [
      "delay_A",
      "delay_B",
      "delay_C"
    ],
    "units": "minutes",
    "step_minutes": 15,
    "horizon_minutes": 60
  },
  "model": {
    "type": "GRU",
    "input_size": 3,
    "hidden_size": 32,
    "num_layers": 1,
    "bidirectional": false,
    "bias": true,
    "dropout": 0,
    "batch_first": true,
    "output_size": 3,
    "output_activation": "softplus"
  },
  "training": {
    "seed": 42,
    "loss": "MSELoss",
    "optimizer": "Adam",
    "learning_rate": 0.001,
    "batch_size": 128,
    "drop_last": false,
    "max_epochs": 30,
    "early_stopping_patience": 5,
    "checkpoint_selection": "minimum_validation_loss_earliest_tie"
  },
  "paths": {
    "input_csv": "../data-project/traffic_delays.csv",
    "weights": "models/best.pt",
    "model_metadata": "models/metadata.json",
    "results": "results",
    "provenance": "../data-project/provenance.json"
  }
}
